  "constraints": [
    {
      "table": "platform_migration_history",
      "kind": "p",
      "definition": "PRIMARY KEY (migration_id)"
    },
    {
      "table": "platform_outbox",
      "kind": "c",
      "definition": "CHECK ((attempt >= 0))"
    },
    {
      "table": "platform_outbox",
      "kind": "c",
      "definition": "CHECK ((state = ANY (ARRAY['pending'::text, 'leased'::text, 'published'::text])))"
    },
    {
      "table": "platform_outbox",
      "kind": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "platform_processing",
      "kind": "c",
      "definition": "CHECK ((attempt >= 0))"
    },
    {
      "table": "platform_processing",
      "kind": "c",
      "definition": "CHECK ((completion_outcome = ANY (ARRAY['succeeded'::text, 'terminal-failure'::text])))"
    },
    {
      "table": "platform_processing",
      "kind": "c",
      "definition": "CHECK ((state = ANY (ARRAY['claimed'::text, 'retry-eligible'::text, 'completed'::text])))"
    },
    {
      "table": "platform_processing",
      "kind": "p",
      "definition": "PRIMARY KEY (outbox_entry_id)"
    },
    {
      "table": "platform_record_change",
      "kind": "c",
      "definition": "CHECK ((action = ANY (ARRAY['created'::text, 'updated'::text, 'deleted'::text, 'restored'::text])))"
    },
    {
      "table": "platform_record_change",
      "kind": "c",
      "definition": "CHECK ((actor_kind = ANY (ARRAY['principal'::text, 'system'::text])))"
    },
    {
      "table": "platform_record_change",
      "kind": "c",
      "definition": "CHECK ((revision > 0))"
    },
    {
      "table": "platform_record_change",
      "kind": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "platform_smoke_work_item",
      "kind": "c",
      "definition": "CHECK ((revision > 0))"
    },
    {
      "table": "platform_smoke_work_item",
      "kind": "c",
      "definition": "CHECK ((state = 'accepted'::text))"
    },
    {
      "table": "platform_smoke_work_item",
      "kind": "p",
      "definition": "PRIMARY KEY (id)"
    }
  ]
