{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "noEmit": false,
    "outDir": "../../.cache/app-platform-smoke-runtime",
    "baseUrl": "../..",
    "paths": {
      "@kanbien/core": [
        "packages/core/src/index.ts"
      ],
      "@kanbien/core/*": [
        "packages/core/src/*/index.ts"
      ],
      "@kanbien/platform-config": [
        "platform/config/src/index.ts"
      ],
      "@kanbien/platform-contracts": [
        "platform/contracts/src/index.ts"
      ],
      "@kanbien/platform-health": [
        "platform/health/src/index.ts"
      ],
      "@kanbien/platform-observability": [
        "platform/observability/src/index.ts"
      ],
      "@kanbien/platform-persistence": [
        "platform/persistence/src/index.ts"
      ],
      "@kanbien/platform-runtime": [
        "platform/runtime/src/index.ts"
      ],
      "@kanbien/platform-security": [
        "platform/security/src/index.ts"
      ],
      "@kanbien/platform-server": [
        "platform/server/src/index.ts"
      ],
      "@kanbien/platform-testing": [
        "platform/testing/src/index.ts"
      ],
      "@kanbien/platform-workers": [
        "platform/workers/src/index.ts"
      ]
    },
    "rootDir": "../..",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/*-runtime.test.ts",
    "../../platform/config/src/**/*.ts",
    "../../platform/contracts/src/**/*.ts",
    "../../platform/health/src/**/*.ts",
    "../../platform/observability/src/**/*.ts",
    "../../platform/persistence/src/**/*.ts",
    "../../platform/runtime/src/**/*.ts",
    "../../platform/security/src/**/*.ts",
    "../../platform/server/src/**/*.ts",
    "../../platform/testing/src/**/*.ts",
    "../../platform/workers/src/**/*.ts"
  ]
}
