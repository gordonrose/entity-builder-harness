# Agentic harness script settings.
# Copy to .agentic/env.local for machine-local overrides.

# Empty chat branch cleanup during chat startup.
# Values:
# - apply: delete empty chat branches and matching commitLogs automatically
# - dry-run: print what would be deleted
# - skip: do not run cleanup
CHAT_CLEANUP_EMPTY_BRANCHES=apply

# Optional absolute root for all chat worktrees created from this repository.
# Leave unset to use $HOME/projects/.chat-worktrees/<repo-name>-<repo-id>.
# A value supplied in the launching environment takes precedence over this file.
# AGENTIC_CHAT_WORKTREE_ROOT=/absolute/path/for/this/repository
