{
  "schema": "core/diagnostic-catalog-export/v1",
  "delivery": {
    "maxRelatedRecords": 8
  },
  "catalog": {
    "owner": "scheduling-target",
    "definitions": [
      {
        "code": "scheduling-target.configuration-invalid",
        "version": 1,
        "classification": {
          "failureKind": "configuration",
          "failureSource": "platform",
          "severity": "error",
          "recovery": "manual_investigation",
          "retryable": false,
          "userCorrectable": false
        },
        "detail": {
          "type": "object",
          "properties": {
            "issues": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "setting": {
                    "type": "enum",
                    "values": [
                      "queue.arn",
                      "queue.region",
                      "database.schema",
                      "authentication.username",
                      "authentication.reference",
                      "queue.address"
                    ]
                  },
                  "reason": {
                    "type": "enum",
                    "values": [
                      "missing",
                      "wrong-type",
                      "blank",
                      "surrounding-whitespace",
                      "invalid-format",
                      "inconsistent-settings"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      {
        "code": "scheduling-target.invocation-failed",
        "version": 1,
        "classification": {
          "failureKind": "unknown",
          "failureSource": "unknown",
          "severity": "error",
          "recovery": "manual_investigation",
          "retryable": false,
          "userCorrectable": false
        },
        "detail": {
          "type": "object",
          "properties": {
            "operation": {
              "type": "enum",
              "values": [
                "dispatch",
                "worker"
              ]
            },
            "phase": {
              "type": "enum",
              "values": [
                "configuration",
                "resources",
                "composition",
                "execution",
                "shutdown"
              ]
            },
            "effect": {
              "type": "enum",
              "values": [
                "not-started",
                "earlier-effects-possible",
                "completion-preserved"
              ]
            }
          }
        }
      },
      {
        "code": "scheduling-target.preflight-failed",
        "version": 1,
        "classification": {
          "failureKind": "unknown",
          "failureSource": "unknown",
          "severity": "error",
          "recovery": "manual_investigation",
          "retryable": false,
          "userCorrectable": false
        },
        "detail": {
          "type": "object",
          "properties": {
            "operation": {
              "type": "enum",
              "values": [
                "dispatch",
                "worker"
              ]
            },
            "check": {
              "type": "enum",
              "values": [
                "request-shape",
                "source-revision",
                "request-identity",
                "function-identity",
                "operation-identity",
                "time-budget",
                "database-connection",
                "database-identity",
                "database-user",
                "database-session",
                "database-privileges",
                "database-rollback",
                "queue-dns",
                "queue-identity",
                "cleanup"
              ]
            },
            "observation": {
              "type": "enum",
              "values": [
                "predicate-rejected",
                "dependency-threw"
              ]
            }
          }
        }
      }
    ]
  }
}
