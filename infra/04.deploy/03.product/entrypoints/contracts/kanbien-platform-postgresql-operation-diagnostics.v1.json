                "migration",
                "compose",
                "create"
              ]
            },
            "phase": {
              "type": "enum",
              "values": [
                "schema-predicate",
                "configuration",
                "writer-construction",
                "input-projection",
                "work-item-id",
                "work-item-state",
                "work-item-revision",
                "work-item-accepted-at",
                "statement-staging",
                "staging-result"
              ]
            },
            "condition": {
              "type": "enum",
              "values": [
                "predicate-rejected",
                "threw",
                "returned-failure"
              ]
            },
            "effect": {
              "type": "enum",
              "values": [
                "not-started",
                "not-staged",
                "unknown"
              ]
