{
  "compilerOptions": {
    "declaration": false,
    "exactOptionalPropertyTypes": true,
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "../../../../.cache/entity-smoke-composition-build",
    "rootDir": "../../../..",
    "strict": true,
    "target": "ES2022",
    "baseUrl": "../../../..",
    "types": [
      "node"
    ]
  },
  "include": [
    "./kanbien-entity-smoke.main.ts",
    "./kanbien-entity-smoke-verifier.main.ts",
    "./kanbien-entity-smoke-administration.main.ts",
    "./kanbien-entity-smoke-migration.main.ts",
    "./kanbien-entity-smoke-database-proof.main.ts",
    "./entity-smoke/**/*.ts"
  ]
}

