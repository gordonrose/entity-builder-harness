{
  "compilerOptions": {
    "declaration": false,
    "exactOptionalPropertyTypes": true,
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "../../../../.cache/core-server-persistence-composition-build",
    "rootDir": "../../../..",
    "strict": true,
    "target": "ES2022",
    "baseUrl": "../../../..",
    "paths": {
      "@kanbien/core": ["packages/core/src/index.ts"],
      "@kanbien/core/*": ["packages/core/src/*/index.ts"],
      "@kanbien/platform-contracts": ["platform/contracts/src/index.ts"],
      "@kanbien/platform-adapter-aws-persistence-postgresql": ["platform/adapters/aws/persistence/postgresql/src/index.ts"],
      "@kanbien/platform-adapter-aws-observability-cloudwatch": ["platform/adapters/aws/observability/cloudwatch/src/index.ts"],
      "@kanbien/platform-config": ["platform/config/src/index.ts"],
      "@kanbien/platform-health": ["platform/health/src/index.ts"],
      "@kanbien/platform-observability": ["platform/observability/src/index.ts"],
      "@kanbien/platform-persistence": ["platform/persistence/src/index.ts"],
      "@kanbien/platform-runtime": ["platform/runtime/src/index.ts"],
      "@kanbien/platform-security": ["platform/security/src/index.ts"],
      "@kanbien/platform-server": ["platform/server/src/index.ts"],
      "@kanbien/platform-server/main": ["platform/server/src/main.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "./kanbien-core-server-persistence.app.ts",
    "./kanbien-core-server-persistence-postgresql.ts",
    "./kanbien-core-server-persistence.main.ts",
    "./kanbien-core-server-persistence-verifier.main.ts",
    "./kanbien-core-server-persistence-migration.main.ts",
    "./kanbien-core-server-persistence-administration.main.ts",
    "./kanbien-core-server-persistence-runtime-credential.ts",
    "./kanbien-core-server-persistence-restore-verifier.main.ts",
    "./kanbien-platform-observability.ts",
    "../../../../packages/core/src/**/*.ts",
    "../../../../platform/config/src/**/*.ts",
    "../../../../platform/contracts/src/**/*.ts",
    "../../../../platform/health/src/**/*.ts",
    "../../../../platform/observability/src/**/*.ts",
    "../../../../platform/persistence/src/**/*.ts",
    "../../../../platform/runtime/src/**/*.ts",
    "../../../../platform/security/src/**/*.ts",
    "../../../../platform/server/src/**/*.ts",
    "../../../../platform/adapters/aws/persistence/postgresql/src/**/*.ts",
    "../../../../platform/adapters/aws/observability/cloudwatch/src/**/*.ts"
  ]
}
