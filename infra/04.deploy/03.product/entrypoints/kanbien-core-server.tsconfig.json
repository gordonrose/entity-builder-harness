{
  "compilerOptions": {
    "declaration": false,
    "exactOptionalPropertyTypes": true,
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "../../../../.cache/core-server-program-build",
    "rootDir": "../../../..",
    "strict": true,
    "target": "ES2022",
    "baseUrl": "../../../..",
    "types": ["node"]
  },
  "include": [
    "./kanbien-core-server.main.ts",
    "../../../../packages/core/src/**/*.ts",
    "../../../../platform/config/src/**/*.ts",
    "../../../../platform/contracts/src/**/*.ts",
    "../../../../platform/health/src/**/*.ts",
    "../../../../platform/observability/src/**/*.ts",
    "../../../../platform/runtime/src/**/*.ts",
    "../../../../platform/security/src/**/*.ts",
    "../../../../platform/server/src/**/*.ts"
  ]
}
