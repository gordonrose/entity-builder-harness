# Default-deny the repository build context. The Dockerfile names every source
# closure it needs, and the only allowed files are the core-server program,
# its approved package sources, and the packaging helper.
*

!package.json
!package-lock.json

!packages/
!packages/core/
!packages/core/**

!platform/
!platform/config/
!platform/config/**
!platform/contracts/
!platform/contracts/**
!platform/health/
!platform/health/**
!platform/observability/
!platform/observability/**
!platform/runtime/
!platform/runtime/**
!platform/security/
!platform/security/**
!platform/server/
!platform/server/**

!infra/
!infra/04.deploy/
!infra/04.deploy/03.product/
!infra/04.deploy/03.product/entrypoints/
!infra/04.deploy/03.product/entrypoints/kanbien-core-server.main.ts
!infra/04.deploy/03.product/entrypoints/kanbien-core-server.tsconfig.json
!infra/04.deploy/03.product/image/
!infra/04.deploy/03.product/image/core-server/
!infra/04.deploy/03.product/image/core-server/**

!scripts/
!scripts/04.deploy/
!scripts/04.deploy/lifecycle/
!scripts/04.deploy/lifecycle/40-package/
!scripts/04.deploy/lifecycle/40-package/build-core-server-image/
!scripts/04.deploy/lifecycle/40-package/build-core-server-image/prepare-runtime.mjs

**/.env
**/*.env
**/*.env.*
**/.aws
**/.aws/**
**/*.pem
**/*.key
**/secrets
**/secrets/**
**/credentials
**/credentials/**
**/node_modules
**/node_modules/**
**/.cache
**/.cache/**

