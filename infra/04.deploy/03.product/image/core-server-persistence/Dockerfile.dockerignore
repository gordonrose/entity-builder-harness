# Default-deny the repository build context. The Dockerfile names every source
# closure it needs, and the only allowed files are the core-server-persistence program,
# its approved package sources, and the packaging helper.
*

!package.json
!package-lock.json

!packages/
!packages/core/
!packages/core/**

!platform/
!platform/config/
!platform/config/**
!platform/contracts/
!platform/contracts/**
!platform/health/
!platform/health/**
!platform/observability/
!platform/observability/**
!platform/runtime/
!platform/runtime/**
!platform/security/
!platform/security/**
!platform/server/
!platform/server/**

!infra/
!infra/04.deploy/
!infra/04.deploy/03.product/
!infra/04.deploy/03.product/entrypoints/
!infra/04.deploy/03.product/entrypoints/kanbien-core-server-persistence*.ts
!infra/04.deploy/03.product/entrypoints/kanbien-platform-observability.ts
!infra/04.deploy/03.product/entrypoints/kanbien-core-server-persistence.tsconfig.json
!infra/04.deploy/03.product/image/
!infra/04.deploy/03.product/image/core-server-persistence/
!infra/04.deploy/03.product/image/core-server-persistence/**

!scripts/
!scripts/04.deploy/
!scripts/04.deploy/lifecycle/
!scripts/04.deploy/lifecycle/40-package/
!scripts/04.deploy/lifecycle/40-package/build-core-server-persistence-image/
!scripts/04.deploy/lifecycle/40-package/build-core-server-persistence-image/*.mjs


!platform/persistence/
!platform/persistence/**
!platform/adapters/
!platform/adapters/aws/
!platform/adapters/aws/persistence/
!platform/adapters/aws/persistence/postgresql/
!platform/adapters/aws/persistence/postgresql/**
!platform/adapters/aws/observability/
!platform/adapters/aws/observability/cloudwatch/
!platform/adapters/aws/observability/cloudwatch/**

# Reapply all high-risk exclusions after the source allowlist.
**/.git
**/.cache
**/commitLogs
**/.env
**/*.env
**/*.env.*
**/secrets
**/secret
**/credentials
**/credential
**/.aws
**/*.pem
**/*.key
**/id_rsa
**/*.log
**/logs
**/tmp
**/temp
**/*.tmp
**/node_modules
**/.venv
**/vendor
**/__pycache__
**/.cache/02.rag-rulebook
**/runtime-cache
**/local-runtime
**/.codex
**/.agents
**/.vscode
**/.idea
**/.npmrc
**/.pypirc
