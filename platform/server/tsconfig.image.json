    "../../products/kanbien-platform/src/**/*.ts",
    "../../infra/04.deploy/03.product/entrypoints/**/*.ts",
    "../config/src/**/*.ts",
    "../contracts/src/**/*.ts",
    "../health/src/**/*.ts",
    "../observability/src/**/*.ts",
    "../persistence/src/**/*.ts",
    "../runtime/src/**/*.ts",
    "../security/src/**/*.ts",
    "../workers/src/**/*.ts",
    "../adapters/aws/auth/cognito/src/**/*.ts",
    "../adapters/aws/observability/cloudwatch/src/**/*.ts",
    "../adapters/aws/persistence/dynamodb/src/**/*.ts",
